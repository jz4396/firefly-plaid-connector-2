<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging config with secret redaction. All console output goes through MaskingMessageConverter (%msg) and
  MaskingThrowableConverter (%wEx), which mask Plaid access tokens, the Plaid client secret and id, the Firefly
  personal access token, JWTs, bearer headers and secret-looking key/value pairs.
  If you replace this file (e.g. with -Dlogging.config), keep these conversion rules or you lose redaction.
-->
<configuration>
    <conversionRule conversionWord="msg" class="net.djvk.fireflyPlaidConnector2.logging.MaskingMessageConverter"/>
    <conversionRule conversionWord="m" class="net.djvk.fireflyPlaidConnector2.logging.MaskingMessageConverter"/>
    <conversionRule conversionWord="message" class="net.djvk.fireflyPlaidConnector2.logging.MaskingMessageConverter"/>
    <conversionRule conversionWord="maskedEx" class="net.djvk.fireflyPlaidConnector2.logging.MaskingThrowableConverter"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${PID:- } --- [%t] %-40.40logger{39} : %msg%n%maskedEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
